# GMI Cloud API key — https://console.gmicloud.ai → API Keys.
# Used by `npm run enrich` (paper summaries + graphics) and by /api/summarize
# (on-demand summaries for the live feed). If unset, the script also looks in
# ~/.config/gmi/.env, where the `gmi` CLI stores it.
GMI_API_KEY=

# Optional overrides
# ATLAS_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
# ATLAS_IMAGE_MODEL=seedream-4-0-250828

# Optional: Semantic Scholar API key for `npm run discover` (unauthenticated calls are throttled)
# S2_API_KEY=

# TypeSafe Jev — typed judgments for classification and filtering (relevance, domain,
# significance, real-hardware, open-artifacts, survey, foundation-model facets).
# Used by `npm run classify` and, when set, by the screening step of `npm run discover`.
# Either a direct TypeSafe key (https://console.typesafe.ai/keys) …
TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest
# … or a Vercel AI Gateway key, which routes to typesafe-ai/jev through the gateway.
# (The Vercel account must have a credit card on file or the gateway returns 403.)
AI_GATEWAY_API_KEY=
# ATLAS_JEV_GATEWAY_MODEL=typesafe-ai/jev
